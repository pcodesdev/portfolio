{
  "private": true,
  "name": "pcodesdev",
  "version": "0.1.0",
  "homepage": "https://pcodesdev.github.io",
  "scripts": {
    "build": "cross-env PUBLIC_URL=https://pcodesdev.github.io react-scripts --openssl-legacy-provider build",
    "curate:featured": "node scripts/curate-featured-content.mjs",
    "curate:validate": "node scripts/curate-featured-content.mjs --validate",
    "predeploy": "npm run build",
    "deploy": "node scripts/deploy-live-site.mjs",
    "eject": "react-scripts eject",
    "fetch:medium": "node scripts/curate-featured-content.mjs",
    "security:scan": "node scripts/check-no-secrets.mjs",
    "start": "cross-env HOST=127.0.0.1 react-scripts --openssl-legacy-provider start",
    "test": "react-scripts test",
    "test:curation": "node --test scripts/tests/curation-pipeline.test.mjs scripts/tests/deploy-live-site.test.mjs scripts/tests/image-enrichment.test.mjs",
    "verify:build": "node scripts/verify-build-content.mjs",
    "verify:live": "node scripts/verify-live-content.mjs"
  },
  "dependencies": {
    "baseui": "^9.65.3",
    "chart.js": "^2.9.3",
    "ipaddr.js": "2.5.0",
    "node-fetch": "^2.6.0",
    "prettier-package-json": "^2.1.3",
    "react": "^16.10.2",
    "react-bootstrap": "^1.0.0-beta.16",
    "react-chartjs-2": "^2.9.0",
    "react-dom": "^16.10.2",
    "react-helmet": "^6.1.0",
    "react-is": "16.13.1",
    "react-router-dom": "^5.1.2",
    "styled-components": "^5.1.1",
    "styletron-engine-atomic": "^1.4.6",
    "styletron-react": "^5.2.7"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "dotenv": "^6.2.0",
    "cross-env": "7.0.3",
    "gh-pages": "6.3.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "prettier": "2.0.5",
    "react-scripts": "5.0.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "deepmerge": "4.3.1",
    "moment-timezone": "0.5.46",
    "nth-check": "2.1.1",
    "postcss": "8.5.32",
    "resolve-url-loader": "5.0.0",
    "serialize-javascript": "7.1.3",
    "svgo": "2.8.4",
    "underscore": "1.13.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": "prettier --write",
    "*.{js,css,md}": "prettier --write"
  }
}
